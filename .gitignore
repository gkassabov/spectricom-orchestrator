# Environment
.env
.env.*
venv/
__pycache__/
*.pyc
*.pyo

# Credentials & tokens (NEVER commit)
drive-credentials.json
drive-token.json
*-credentials.json
*-token.json
spectricom-claude-key.txt

# Runtime state (regenerated; do not commit)
*.pid
state.json
queue-state.json
rate-limits.json
running.json
bridge-hashes.json
drive-watcher-hashes.json
state/

# Backup files
*.bak

# Logs and reports (regenerated by pipeline)
logs/
reports/

# SIT archive (reports archived per-run; .gitkeep preserves directory)
sit-archive/*.json

# Output (regenerated by pipeline)
output/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# ── S7-CORE-4 additions ──────────────────────────────────────────
# Backup files: `*.bak` above missed `-bak` and `.bak-<suffix>` forms
*-bak
*.bak-*

# Stale doc copies (SESSION-BOOT §2: session-docs/ = STALE copies only)
session-docs/

# Per-session run drivers + one-off fire scripts (regenerated)
_drivers/
fire-*.sh
s6s*-fire-*.sh
zadar-queue-*.sh

# Queue runtime state (done/failed markers)
queue/
